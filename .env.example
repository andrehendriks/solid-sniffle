# PostgreSQL
POSTGRES_USER=homelab
POSTGRES_PASSWORD=homelab_secret
POSTGRES_PORT=5432

# Backend
SECRET_KEY=change-me-in-production-please
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# SMB Benchmark (optional)
SMB_HOST=192.168.1.100
SMB_SHARE=benchmarks
SMB_USERNAME=guest
SMB_PASSWORD=

# Kubernetes (optional - path inside container)
K8S_KUBECONFIG=

# iperf3 server for network benchmarks (optional)
IPERF3_SERVER=192.168.1.1

# Path to use for NAS disk benchmarks
NAS_BENCHMARK_PATH=/benchmark

# Webhook URL for alert notifications (optional)
ALERT_WEBHOOK_URL=
