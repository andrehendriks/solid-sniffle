# ============================================================
#  HomeLab Benchmark Center — Environment Variables
#  Copy this file to .env and fill in your values.
#  Used by both docker-compose.yml and docker-compose.synology.yml
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=changeme

# ── Backend ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-please
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── NAS Benchmark ─────────────────────────────────────────────
# Synology: maps to /volume1/docker/homelab-benchmark/scratch
NAS_BENCHMARK_PATH=/mnt/nas_bench

# ── SMB Benchmark (optional) ──────────────────────────────────
SMB_HOST=192.168.1.100
SMB_SHARE=benchmarks
SMB_USER=guest
SMB_PASSWORD=
SMB_DOMAIN=WORKGROUP

# ── Network Benchmark ─────────────────────────────────────────
PING_HOST=8.8.8.8
DNS_HOST=8.8.8.8
# iperf3 server — leave empty to skip bandwidth test
IPERF3_SERVER=

# ── Kubernetes (optional) ─────────────────────────────────────
# Directory containing kubeconfig (mounted read-only into container)
K8S_KUBECONFIG_DIR=/root/.kube

# ── Alerts ────────────────────────────────────────────────────
# Optional webhook (e.g. ntfy, Gotify, Discord, Slack)
ALERT_WEBHOOK_URL=
